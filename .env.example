# VibexCorp LinkedIn Outreach - Environment Variables

# Environment
ENV=development
PORT=8080
LOG_LEVEL=info

# Database (PostgreSQL 16)
DATABASE_URL=postgres://vibex_admin:vibex_secure_password_2026@localhost:5432/vibex_outreach?sslmode=disable
POSTGRES_DB=vibex_outreach
POSTGRES_USER=vibex_admin
POSTGRES_PASSWORD=vibex_secure_password_2026

# Cache & Queues (Redis 7)
REDIS_URL=redis://:vibex_redis_pass_2026@localhost:6379/0
REDIS_PASSWORD=vibex_redis_pass_2026

# JWT Authentication
JWT_SECRET=vibexcorp-enterprise-jwt-super-secret-key-32b
JWT_EXPIRATION_HOURS=72

# Worker Configuration
WORKER_CONCURRENCY=10
SCHEDULER_INTERVAL_SECONDS=5

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_EVENTS_URL=http://localhost:8080/api/v1/events/stream

# Typesafe AI (Jev) — assist de automação humana (backend /assist/humanize)
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=cole_sua_api_key_aqui
TYPESAFE_MODEL=jev-1.13.0
JEV_CONFIDENCE_FLOOR=0.5
